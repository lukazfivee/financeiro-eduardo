{
  "name": "financeiro-cengtec",
  "version": "0.4.0",
  "description": "Sistema financeiro da CENGTEC com visão geral privada por perfil e gestão de serviços compartilhada",
  "author": "CENGTEC",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && node --check public/app.js && node --check public/services.js && node --check public/theme.js && node --check public/sw.js && node --check desktop/main.cjs",
    "db:local": "wrangler d1 execute financeiro-eduardo --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute financeiro-eduardo --remote --file=./schema.sql",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "br.com.cengtec.financeiro",
    "productName": "Financeiro CENGTEC",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false,
      "artifactName": "Financeiro-CENGTEC-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "wrangler": "^4.33.1"
  }
}
