name = "financeiro-eduardo"
main = "src/index.js"
compatibility_date = "2026-08-26"
workers_dev = true

[observability]
enabled = true

[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = [ "/api/*", "/health" ]

[[d1_databases]]
binding = "DB"
database_name = "financeiro-eduardo"
database_id = "__D1_DATABASE_ID__"
